{
  "name": "puzapaathapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "inject-pwa": "node inject-pwa-tags.js",
    "copy-public": "cp public/favicon.png dist/favicon.png && cp public/manifest.json dist/manifest.json",
    "deploy": "bash deploy-cf-pages.sh",
    "deploy:cf": "bash deploy-cf-pages.sh",
    "deploy:gh": "npx expo export --platform web --output-dir dist && npm run inject-pwa && npm run copy-public && echo 'www.janthari.com' > dist/CNAME && touch dist/.nojekyll && npx gh-pages -d dist --dotfiles"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "expo": "~55.0.6",
    "expo-audio": "~55.0.9",
    "expo-av": "^16.0.8",
    "expo-linear-gradient": "~55.0.8",
    "expo-notifications": "^56.0.13",
    "expo-status-bar": "~55.0.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "gh-pages": "^6.3.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
